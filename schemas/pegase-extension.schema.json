{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pegase:schema:pegase-extension:1",
  "title": "Manifeste d'extension Pégase, version 1",
  "description": "Fichier pegase-extension.json placé à la racine de l'artefact. Voir docs/extensions/manifest-specification.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifeste", "id", "nom", "description", "version", "auteurs", "licence", "compatibilite", "permissions", "points_entree", "capacites"],
  "properties": {
    "$schema": { "type": "string" },
    "manifeste": { "const": 1, "description": "Version du format de manifeste" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$",
      "description": "Identifiant unique et définitif : éditeur/nom, en minuscules"
    },
    "nom": { "type": "string", "minLength": 2, "maxLength": 60 },
    "description": { "type": "string", "minLength": 10, "maxLength": 500 },
    "version": { "$ref": "#/$defs/version" },
    "auteurs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nom"],
        "properties": {
          "nom": { "type": "string", "minLength": 1, "maxLength": 100 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    },
    "licence": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Expression SPDX (MIT, Apache-2.0, AGPL-3.0-or-later…) ou LicenseRef-proprietaire"
    },
    "compatibilite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pegase", "api"],
      "properties": {
        "pegase": { "$ref": "#/$defs/contrainte", "description": "Versions de Pégase acceptées (contrainte semver)" },
        "api": { "type": "string", "pattern": "^[1-9][0-9]*$", "description": "Version majeure de l'API d'extension" }
      }
    },
    "dependances": {
      "type": "object",
      "description": "Autres extensions requises : identifiant → contrainte de version",
      "maxProperties": 10,
      "propertyNames": { "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/$defs/contrainte" }
    },
    "permissions": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "justification"],
        "properties": {
          "id": { "$ref": "#/$defs/permission" },
          "justification": { "type": "string", "minLength": 10, "maxLength": 300 },
          "facultative": { "type": "boolean", "default": false }
        }
      }
    },
    "points_entree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "titre", "fichier", "acces"],
            "properties": {
              "id": { "$ref": "#/$defs/nomCourt" },
              "titre": { "type": "string", "minLength": 1, "maxLength": 80 },
              "fichier": { "$ref": "#/$defs/fichierInterface" },
              "acces": { "$ref": "#/$defs/acces" },
              "parametre": { "type": "boolean", "default": false, "description": "La page accepte un paramètre d'adresse (identifiant d'un document)" }
            }
          }
        },
        "menu": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "libelle"],
            "properties": {
              "page": { "$ref": "#/$defs/nomCourt" },
              "libelle": { "type": "string", "minLength": 1, "maxLength": 30 },
              "acces": { "$ref": "#/$defs/acces" }
            }
          }
        },
        "cartes": {
          "type": "array",
          "maxItems": 3,
          "description": "Cartes de la page d'accueil des comptes (board), comme celles des espaces de création",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "titre", "description"],
            "properties": {
              "page": { "$ref": "#/$defs/nomCourt" },
              "titre": { "type": "string", "minLength": 1, "maxLength": 40 },
              "description": { "type": "string", "minLength": 1, "maxLength": 160 },
              "icone": { "type": "string", "pattern": "^bi-[a-z0-9-]{1,40}$", "description": "Icône Bootstrap Icons" },
              "acces": { "$ref": "#/$defs/acces" }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 10,
          "description": "Actions contextuelles proposées par le Core sur les objets de l'extension",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "libelle", "contexte", "page"],
            "properties": {
              "id": { "$ref": "#/$defs/nomCourt" },
              "libelle": { "type": "string", "minLength": 1, "maxLength": 40 },
              "contexte": { "enum": ["projet"] },
              "page": { "$ref": "#/$defs/nomCourt" }
            }
          }
        },
        "joueur": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fichier"],
          "description": "Interface de jeu des parcours publiés par l'extension, affichée par le lecteur",
          "properties": { "fichier": { "$ref": "#/$defs/fichierInterface" } }
        },
        "parametres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["champs"],
          "description": "Paramètres réglés par les administrateurs dans un formulaire rendu par le Core",
          "properties": {
            "champs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "libelle", "type"],
                "properties": {
                  "id": { "$ref": "#/$defs/nomCourt" },
                  "libelle": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "aide": { "type": "string", "maxLength": 300 },
                  "type": { "enum": ["texte", "texte_long", "nombre", "booleen", "choix"] },
                  "defaut": { "type": ["string", "number", "boolean"] },
                  "obligatoire": { "type": "boolean", "default": false },
                  "longueur_max": { "type": "integer", "minimum": 1, "maximum": 5000 },
                  "minimum": { "type": "number" },
                  "maximum": { "type": "number" },
                  "choix": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["valeur", "libelle"],
                      "properties": {
                        "valeur": { "type": "string", "maxLength": 100 },
                        "libelle": { "type": "string", "maxLength": 100 }
                      }
                    }
                  }
                },
                "allOf": [
                  { "if": { "properties": { "type": { "const": "choix" } } }, "then": { "required": ["choix"] } }
                ]
              }
            }
          }
        }
      }
    },
    "capacites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "serveur"],
      "properties": {
        "interface": { "type": "boolean", "description": "Niveau 1 : pages et joueur en iframe isolée" },
        "serveur": { "type": "boolean", "description": "Niveau 2 : module WebAssembly exécuté par l'agent d'exécution" }
      }
    },
    "serveur": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "gestionnaires"],
      "properties": {
        "module": { "type": "string", "pattern": "^serveur/[a-z0-9][a-z0-9._-]{0,60}\\.wasm$" },
        "gestionnaires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["evenement", "sante", "tache", "appel"] }
        },
        "limites": {
          "type": "object",
          "additionalProperties": false,
          "description": "Limites demandées ; le Core applique le minimum entre celles-ci et les siennes",
          "properties": {
            "duree_ms": { "type": "integer", "minimum": 10, "maximum": 10000 },
            "memoire_mo": { "type": "integer", "minimum": 1, "maximum": 256 },
            "calcul": { "type": "integer", "minimum": 1000, "maximum": 10000000000 }
          }
        },
        "taches": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "frequence"],
            "properties": {
              "id": { "$ref": "#/$defs/nomCourt" },
              "frequence": { "enum": ["horaire", "quotidienne", "hebdomadaire"] }
            }
          }
        }
      }
    },
    "evenements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abonnements": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nomEvenement" }
        },
        "publies": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "description": "Événements que l'extension publie, préfixés par son identifiant (ext.editeur.nom.*)",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}(\\.[a-z][a-z0-9_]{0,30}){0,2}$" }
        }
      }
    },
    "stockage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "collections"],
      "properties": {
        "version": { "type": "integer", "minimum": 1, "description": "Version du schéma des données, incrémentée à chaque migration" },
        "collections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nom", "portee"],
            "properties": {
              "nom": { "$ref": "#/$defs/nomCourt" },
              "portee": { "enum": ["utilisateur", "partage"] },
              "documents_max": { "type": "integer", "minimum": 1, "maximum": 100000 }
            }
          }
        },
        "quota_mo": { "type": "integer", "minimum": 1, "maximum": 500, "description": "Quota demandé (données et fichiers) ; l'administrateur peut le réduire" },
        "migrations": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vers", "operations"],
            "properties": {
              "vers": { "type": "integer", "minimum": 2 },
              "operations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": { "$ref": "#/$defs/operationMigration" }
              }
            }
          }
        },
        "retention_jours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650,
          "description": "Durée de conservation conseillée après désinstallation ; l'administrateur décide"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depot": { "$ref": "#/$defs/url" },
        "page": { "$ref": "#/$defs/url" },
        "support": { "$ref": "#/$defs/url" },
        "icone": { "type": "string", "pattern": "^interface/[a-z0-9][a-z0-9._/-]{0,100}\\.png$" },
        "categories": {
          "type": "array",
          "maxItems": 5,
          "items": { "enum": ["espace-de-creation", "jeu", "evaluation", "outil", "administration", "communication", "autre"] }
        },
        "tarif": { "enum": ["gratuit", "payant"], "default": "gratuit" },
        "mots_cles": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 30 } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "capacites": { "properties": { "serveur": { "const": true } } } } },
      "then": { "required": ["serveur"] },
      "else": { "not": { "required": ["serveur"] } }
    }
  ],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$",
      "maxLength": 40
    },
    "contrainte": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[0-9A-Za-z.*^~<>=|, -]+$",
      "description": "Contrainte semver au format Composer : ^1.2, ~1.2.3, >=1.8.0 <2.0.0, 1.2.3, *"
    },
    "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 300 },
    "nomCourt": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "acces": { "enum": ["public", "connecte", "valide", "administration"], "default": "connecte" },
    "fichierInterface": {
      "type": "string",
      "pattern": "^(interface|joueur)/[A-Za-z0-9][A-Za-z0-9._/-]{0,150}\\.html$",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
    },
    "permission": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "utilisateur:profil", "utilisateur:institution",
            "stockage:prive", "stockage:partage",
            "fichiers:deposer",
            "projets:lire", "projets:creer", "projets:modifier", "projets:supprimer",
            "parcours:publier", "resultats:lire",
            "evenements:publier"
          ]
        },
        { "pattern": "^evenements:[a-z][a-z0-9_]{0,30}(\\.[a-z][a-z0-9_]{0,30}){1,5}$" },
        { "pattern": "^ressources:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" }
      ]
    },
    "nomEvenement": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}(\\.[a-z][a-z0-9_]{0,30}){1,5}$" },
    "operationMigration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "collection", "champ", "nouveau_nom"],
          "properties": {
            "operation": { "const": "renommer_champ" },
            "collection": { "$ref": "#/$defs/nomCourt" },
            "champ": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
            "nouveau_nom": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "collection", "champ", "valeur"],
          "properties": {
            "operation": { "const": "valeur_par_defaut" },
            "collection": { "$ref": "#/$defs/nomCourt" },
            "champ": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
            "valeur": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "collection", "champ"],
          "properties": {
            "operation": { "const": "supprimer_champ" },
            "collection": { "$ref": "#/$defs/nomCourt" },
            "champ": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "collection", "nouveau_nom"],
          "properties": {
            "operation": { "const": "renommer_collection" },
            "collection": { "$ref": "#/$defs/nomCourt" },
            "nouveau_nom": { "$ref": "#/$defs/nomCourt" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "collection"],
          "properties": {
            "operation": { "const": "supprimer_collection" },
            "collection": { "$ref": "#/$defs/nomCourt" }
          }
        }
      ]
    }
  }
}
